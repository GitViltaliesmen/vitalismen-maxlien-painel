[Unit]
Description=Vitalismen EC V114 strict read-only next eligible post-sale observer
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/vitalismen-automacao/current
ExecStart=/opt/vitalismen-automacao/current/ops/post-sale-next-eligible-v114 observe
TimeoutStartSec=900
PrivateTmp=true
