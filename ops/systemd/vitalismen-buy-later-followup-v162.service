[Unit]
Description=Vitalismen EC isolated Comprar depois follow-up V162
After=network-online.target mongod.service
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/vitalismen-automacao/current

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/vitalismen-automacao/current
ExecStart=/opt/vitalismen-automacao/current/ops/buy-later-followup-v162 run
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/vitalismen-deploy /var/log/vitalismen-deploy
TimeoutStartSec=3min

[Install]
WantedBy=multi-user.target
