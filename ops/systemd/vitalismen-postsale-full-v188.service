[Unit]
Description=Vitalismen EC full post-sale executor V188
After=network-online.target mongod.service
Wants=network-online.target
ConditionPathIsSymbolicLink=/opt/vitalismen-automacao/current

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/vitalismen-automacao/current
ExecStart=/opt/vitalismen-automacao/current/ops/post-sale-v188 run
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/vitalismen-deploy /var/log/vitalismen-deploy /opt/vitalismen-automacao/shared -/opt/vitalismen-automacao/current/public/media/generated
TimeoutStartSec=8min

[Install]
WantedBy=multi-user.target
