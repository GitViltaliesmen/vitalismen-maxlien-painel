#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

stage_test_mode="${VITALISMEN_STAGE_TEST_MODE:-false}"

if [[ "$stage_test_mode" == "true" ]]; then
  base_dir="${VITALISMEN_STAGE_TEST_BASE_DIR:?base sintética ausente}"
  state_dir="${VITALISMEN_STAGE_TEST_STATE_DIR:?state sintético ausente}"
  protected_log_dir="${VITALISMEN_STAGE_TEST_LOG_DIR:?log sintético ausente}"
  repo_url="${VITALISMEN_STAGE_TEST_REPO_URL:-https://example.invalid/vitalismen.git}"
  expected_uid="$(id -u)"
  expected_gid="$(id -g)"
  strict_root_owner=0
else
  [[ "$stage_test_mode" == "false" ]] || {
    echo "ERRO: modo de execução inválido" >&2
    exit 1
  }
  [[ "${EUID}" -eq 0 ]] || {
    echo "ERRO: execute como root" >&2
    exit 1
  }
  export HOME=/root
  export USER=root
  export LOGNAME=root
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  base_dir="/opt/vitalismen-automacao"
  state_dir="/var/lib/vitalismen-deploy"
  protected_log_dir="/var/log/vitalismen-deploy"
  repo_url="https://github.com/GitViltaliesmen/vitalismen-maxlien-painel.git"
  expected_uid=0
  expected_gid=0
  strict_root_owner=1
fi

releases_dir="$base_dir/releases"
permit_file="$state_dir/activate-permit.json"
process_name="vitalismen-automation"
if [[ "$stage_test_mode" == "true" ]]; then
  official_health_url="${VITALISMEN_STAGE_OFFICIAL_HEALTH_URL:?health oficial mock ausente}"
  official_panel_url="${VITALISMEN_STAGE_OFFICIAL_PANEL_URL:?painel oficial mock ausente}"
  local_health_url="${VITALISMEN_STAGE_LOCAL_HEALTH_URL:?health local mock ausente}"
else
  official_health_url="https://ec.maxlien.shop/api/health/"
  official_panel_url="https://ec.maxlien.shop/n/"
  local_health_url="http://127.0.0.1:3001/api/health/"
fi
sudoers_file="/etc/sudoers.d/vitalismen-codex-stage"
allowed_activate_command="/usr/local/sbin/vitalismen-stage v66-activate-safe"

if [[ "$stage_test_mode" == "true" ]]; then
  node_cmd="${VITALISMEN_STAGE_NODE_CMD:?node mock ausente}"
  pm2_cmd="${VITALISMEN_STAGE_PM2_CMD:?pm2 mock ausente}"
  curl_cmd="${VITALISMEN_STAGE_CURL_CMD:?curl mock ausente}"
  readlink_cmd="${VITALISMEN_STAGE_READLINK_CMD:?readlink mock ausente}"
  ln_cmd="${VITALISMEN_STAGE_LN_CMD:?ln mock ausente}"
  mv_cmd="${VITALISMEN_STAGE_MV_CMD:?mv mock ausente}"
  unlink_cmd="${VITALISMEN_STAGE_UNLINK_CMD:?unlink mock ausente}"
  env_cmd="${VITALISMEN_STAGE_ENV_CMD:?env mock ausente}"
  sleep_cmd="${VITALISMEN_STAGE_SLEEP_CMD:?sleep mock ausente}"
  sha256_cmd="${VITALISMEN_STAGE_SHA256_CMD:?sha256 mock ausente}"
  git_cmd="${VITALISMEN_STAGE_GIT_CMD:-git}"
  npm_cmd="${VITALISMEN_STAGE_NPM_CMD:-npm}"
  compatibility_runner="${VITALISMEN_STAGE_COMPATIBILITY_RUNNER:?compatibility mock ausente}"
  guard_runner="${VITALISMEN_STAGE_GUARD_RUNNER:?guard mock ausente}"
  flock_cmd="${VITALISMEN_STAGE_FLOCK_CMD:?flock mock ausente}"
  stage_lock_file="${VITALISMEN_STAGE_TEST_STAGE_LOCK_FILE:-$state_dir/vitalismen-stage-stage.lock}"
else
  node_cmd="/usr/bin/node"
  pm2_cmd="/usr/bin/pm2"
  curl_cmd="/usr/bin/curl"
  readlink_cmd="/usr/bin/readlink"
  ln_cmd="/usr/bin/ln"
  mv_cmd="/usr/bin/mv"
  unlink_cmd="/usr/bin/unlink"
  env_cmd="/usr/bin/env"
  sleep_cmd="/usr/bin/sleep"
  sha256_cmd="/usr/bin/sha256sum"
  git_cmd="/usr/bin/git"
  npm_cmd="/usr/bin/npm"
  compatibility_runner=""
  guard_runner=""
  flock_cmd="/usr/bin/flock"
  stage_lock_file="/run/lock/vitalismen-stage.lock"
fi

v66_runtime_version=66
safe_profile_name="V66_SAFE_OBSERVATION_ONLY"
safe_overlay_name=".env.v66-safe-observation"
v70_guard_chain_version=70
v70_data_compatibility_version=66
publication_metadata_name=".release-publication.json"
publication_complete_name=".publication-complete.json"

die() {
  echo "ERRO: $*" >&2
  exit 1
}

ensure_private_dirs() {
  if [[ "$stage_test_mode" == "true" ]]; then
    mkdir -p -- "$@"
  else
    install -d -o root -g root -m 0700 "$@"
  fi
}

secure_mode() {
  local mode="$1"
  shift
  if [[ "$stage_test_mode" != "true" ]]; then
    chmod "$mode" "$@"
  fi
}

safe_label() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_-' '_'
}

run_protected() {
  [[ "$#" -ge 2 ]] || die "run_protected exige LABEL e COMMAND"

  local raw_label="$1"
  local label
  local executable
  local operation_scope
  local output_file
  local audit_file
  local started_at
  local finished_at
  local exit_status

  [[ -n "$raw_label" ]] || die "run_protected recebeu LABEL vazio"
  label="$(safe_label "$raw_label")"
  [[ -n "$label" ]] || die "run_protected recebeu LABEL inválido"
  shift

  executable="$1"
  [[ -n "$executable" ]] || die "run_protected recebeu COMMAND vazio"
  if [[ "$executable" == */* ]]; then
    [[ -f "$executable" && -x "$executable" ]] ||
      die "run_protected não encontrou binário executável para $label"
  else
    command -v "$executable" >/dev/null 2>&1 ||
      die "run_protected não encontrou comando para $label"
  fi

  operation_scope="${release_name:-runtime}"
  output_file="$protected_log_dir/${operation_scope}.${label}.log"
  audit_file="$protected_log_dir/vitalismen-stage-operations.jsonl"
  ensure_private_dirs "$protected_log_dir"
  : >"$output_file"
  secure_mode 0600 "$output_file"
  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  if "$@" >"$output_file" 2>&1; then
    exit_status=0
  else
    exit_status=$?
  fi

  finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '{"label":"%s","startedAt":"%s","finishedAt":"%s","exitStatus":%s}\n' \
    "$label" "$started_at" "$finished_at" "$exit_status" >>"$audit_file"
  secure_mode 0600 "$audit_file"

  if [[ "$exit_status" -eq 0 ]]; then
    echo "GATE_${label}=OK"
    return 0
  fi

  echo "GATE_${label}=FALHOU"
  echo "DETALHES_PROTEGIDOS=$output_file"
  return "$exit_status"
}

new_activation_id() {
  local prefix="$1"
  local value="${VITALISMEN_STAGE_ACTIVATION_ID:-${prefix}-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
  [[ "$value" =~ ^[A-Za-z0-9_-]{1,100}$ ]] || die "activation id inválido"
  printf '%s' "$value"
}

release_dir_for_name() {
  local requested_release="$1"
  [[ "$requested_release" =~ ^[0-9]{8}T[0-9]{6}Z_production-[0-9]{8}-[0-9a-f]{7}$ ]] ||
    die "nome da release fora do padrão oficial"
  printf '%s/%s' "$releases_dir" "$requested_release"
}

validate_authorized_source_ref() {
  local requested_ref="$1"
  local authorized_ref="${VITALISMEN_STAGE_AUTHORIZED_SOURCE_REF:-}"

  [[ -n "$authorized_ref" ]] || die "ref remota autorizada ausente"
  [[ "$requested_ref" == "$authorized_ref" ]] || die "source ref não corresponde à ref exata autorizada"
  [[ "$requested_ref" =~ ^refs/heads/codex/[A-Za-z0-9][A-Za-z0-9._/-]{0,198}[A-Za-z0-9]$ ]] ||
    die "source ref fora do namespace fechado de candidatas"
  [[ "$requested_ref" != *".."* && "$requested_ref" != *"//"* && "$requested_ref" != *"@{"* ]] ||
    die "source ref contém sintaxe Git ambígua"
  [[ "$requested_ref" != *.lock && "$requested_ref" != */. && "$requested_ref" != */.. ]] ||
    die "source ref contém componente proibido"
  "$git_cmd" check-ref-format "$requested_ref" >/dev/null 2>&1 ||
    die "source ref Git inválida"
}

remote_production_head() {
  local listing
  local commit

  listing="$("$git_cmd" ls-remote --heads "$repo_url" refs/heads/production)" ||
    die "não foi possível fotografar origin/production"
  [[ "$(printf '%s\n' "$listing" | sed '/^$/d' | wc -l | tr -d ' ')" == "1" ]] ||
    die "origin/production ausente ou ambígua"
  commit="$(printf '%s\n' "$listing" | awk 'NR==1 {print tolower($1)}')"
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "commit de origin/production inválido"
  printf '%s' "$commit"
}

remote_optional_production_tag_commit() {
  local tag_name="$1"
  local listing
  local commit

  listing="$("$git_cmd" ls-remote --tags "$repo_url" \
    "refs/tags/${tag_name}" "refs/tags/${tag_name}^{}")" ||
    die "não foi possível observar tag de produção opcional"
  if [[ -z "$listing" ]]; then
    printf 'ABSENT'
    return 0
  fi
  commit="$(printf '%s\n' "$listing" | awk '$2 ~ /\^\{\}$/ {print tolower($1); found=1} END {if (!found) print tolower(first)} NR==1 {first=$1}' | tail -n 1)"
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "tag de produção opcional inválida"
  printf '%s' "$commit"
}

remote_required_production_tag_commit() {
  local tag_name="$1"
  local listing
  local commit

  [[ "$tag_name" =~ ^production-[0-9]{8}-[0-9a-f]{7}$ ]] ||
    die "tag de publicação fora do formato oficial"
  listing="$("$git_cmd" ls-remote --tags "$repo_url" \
    "refs/tags/${tag_name}" "refs/tags/${tag_name}^{}")" ||
    die "não foi possível verificar a tag remota obrigatória"
  [[ -n "$listing" ]] || die "tag remota obrigatória ausente"
  [[ "$(printf '%s\n' "$listing" | awk \
    -v ref="refs/tags/${tag_name}" -v peeled="refs/tags/${tag_name}^{}" \
    '$2 == ref || $2 == peeled {count++} END {print count+0}')" -ge 1 ]] ||
    die "tag remota obrigatória ausente ou ambígua"
  commit="$(printf '%s\n' "$listing" | awk \
    -v direct="refs/tags/${tag_name}" -v peeled="refs/tags/${tag_name}^{}" \
    '$2 == peeled {peeledCommit=tolower($1)} $2 == direct {directCommit=tolower($1)} END {print peeledCommit ? peeledCommit : directCommit}')"
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "target da tag remota inválido"
  printf '%s' "$commit"
}

functional_payload_sha256() {
  local candidate_root="$1"
  "$node_cmd" - "$candidate_root" <<'NODE'
const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');
const root = path.resolve(process.argv[2]);
const excludedRootFiles = new Set([
  '.env',
  '.env.v66-safe-observation',
  '.release-source.json',
  '.staging-complete.json',
  '.release-publication.json',
  '.publication-complete.json',
  '.activation-complete.json'
]);
const hash = crypto.createHash('sha256');
const visit = (directory, relative = '') => {
  const entries = fs.readdirSync(directory, {withFileTypes: true})
    .filter((entry) => !(relative === '' && excludedRootFiles.has(entry.name)))
    .filter((entry) => entry.name !== '.git' && entry.name !== 'node_modules')
    .sort((left, right) => left.name.localeCompare(right.name, 'en'));
  for (const entry of entries) {
    const childRelative = relative ? `${relative}/${entry.name}` : entry.name;
    const child = path.join(directory, entry.name);
    const stats = fs.lstatSync(child);
    if (stats.isDirectory()) {
      visit(child, childRelative);
      continue;
    }
    hash.update(childRelative, 'utf8');
    hash.update('\0');
    if (stats.isSymbolicLink()) {
      hash.update('symlink\0');
      hash.update(fs.readlinkSync(child), 'utf8');
      hash.update('\0');
      continue;
    }
    if (!stats.isFile()) throw new Error(`tipo funcional não suportado: ${childRelative}`);
    hash.update(`file:${(stats.mode & 0o111) !== 0 ? 'x' : '-'}\0`);
    hash.update(fs.readFileSync(child));
    hash.update('\0');
  }
};
visit(root);
process.stdout.write(hash.digest('hex'));
NODE
}

directory_payload_sha256() {
  local candidate_root="$1"
  "$node_cmd" - "$candidate_root" <<'NODE'
const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');
const root = path.resolve(process.argv[2]);
if (!fs.existsSync(root)) {
  process.stdout.write('ABSENT');
  process.exit(0);
}
const hash = crypto.createHash('sha256');
const visit = (directory, relative = '') => {
  const entries = fs.readdirSync(directory, {withFileTypes: true})
    .sort((left, right) => left.name.localeCompare(right.name, 'en'));
  for (const entry of entries) {
    const childRelative = relative ? `${relative}/${entry.name}` : entry.name;
    const child = path.join(directory, entry.name);
    const stats = fs.lstatSync(child);
    if (stats.isDirectory()) {
      hash.update(`dir:${childRelative}\0`, 'utf8');
      visit(child, childRelative);
      continue;
    }
    hash.update(childRelative, 'utf8');
    hash.update('\0');
    if (stats.isSymbolicLink()) {
      hash.update('symlink\0');
      hash.update(fs.readlinkSync(child), 'utf8');
      hash.update('\0');
      continue;
    }
    if (!stats.isFile()) throw new Error(`tipo não suportado: ${childRelative}`);
    hash.update(`file:${(stats.mode & 0o111) !== 0 ? 'x' : '-'}\0`);
    hash.update(fs.readFileSync(child));
    hash.update('\0');
  }
};
visit(root);
process.stdout.write(hash.digest('hex'));
NODE
}

current_target() {
  "$readlink_cmd" -f "$base_dir/current" 2>/dev/null || true
}

pm2_snapshot() {
  "$pm2_cmd" jlist | "$node_cmd" -e '
let input = "";
process.stdin.on("data", (chunk) => { input += chunk; });
process.stdin.on("end", () => {
  const list = JSON.parse(input || "[]");
  const processInfo = list.find((entry) => entry.name === process.argv[1]);
  if (!processInfo) {
    process.stdout.write("NOT_FOUND\t0\tmissing\t\t");
    return;
  }
  const env = processInfo.pm2_env || {};
  process.stdout.write([
    "FOUND",
    String(processInfo.pid || 0),
    String(env.status || "unknown"),
    String(env.pm_cwd || ""),
    String(env.pm_exec_path || "")
  ].join("\t"));
});
' "$process_name"
}

detect_source_process_state() {
  local snapshot
  local found
  local pid
  local status
  local pm_cwd
  local pm_exec_path

  snapshot="$(pm2_snapshot)" || die "não foi possível ler o estado PM2"
  IFS=$'\t' read -r found pid status pm_cwd pm_exec_path <<<"$snapshot"
  [[ "$found" == "FOUND" ]] || die "processo PM2 $process_name ausente"

  source_pm2_pid="$pid"
  source_pm2_status="$status"
  source_pm_cwd="$pm_cwd"
  source_pm_exec_path="$pm_exec_path"

  if [[ "$status" == "online" && "$pid" =~ ^[1-9][0-9]*$ ]]; then
    source_process_state="ONLINE"
  elif [[ "$status" == "stopped" && "$pid" == "0" ]]; then
    source_process_state="STOPPED_CONTAINMENT"
  else
    die "estado PM2 não suportado: status=$status pid=$pid"
  fi

  source_current="$(current_target)"
  [[ -n "$source_current" ]] || die "current não possui destino válido"
  case "$source_current" in
    "$releases_dir/"*) ;;
    *) die "current aponta para fora de releases" ;;
  esac
  [[ -d "$source_current" && ! -L "$source_current" ]] ||
    die "release de origem inválida"
  [[ -f "$source_current/.release-source.json" ]] ||
    die "metadata da release de origem ausente"

  case "$source_pm_cwd" in
    "$base_dir/current"|"$source_current") ;;
    *) die "pm_cwd não corresponde ao current oficial: obtido=$source_pm_cwd esperado=$base_dir/current" ;;
  esac
  case "$source_pm_exec_path" in
    "$base_dir/current/src/index.js"|"$source_current/src/index.js") ;;
    *) die "pm_exec_path não corresponde ao current oficial: obtido=$source_pm_exec_path esperado=$base_dir/current/src/index.js" ;;
  esac
}

validate_v70_release() {
  local candidate_dir="$1"
  local candidate_name="$2"
  local payload
  local publication_metadata="$candidate_dir/$publication_metadata_name"
  local publication_complete="$candidate_dir/$publication_complete_name"
  local publication_metadata_exists=0
  local publication_complete_exists=0
  local remote_tag_commit

  [[ -d "$candidate_dir" && ! -L "$candidate_dir" ]] || die "release candidata inválida"
  [[ -f "$candidate_dir/.env" ]] || die ".env protegido ausente na candidata"
  [[ -f "$candidate_dir/.release-source.json" ]] || die "release-source ausente"
  [[ -f "$candidate_dir/.staging-complete.json" ]] || die "staging-complete ausente"
  [[ -f "$candidate_dir/$safe_overlay_name" ]] || die "overlay safe ausente na candidata"
  [[ -f "$candidate_dir/docs/freeze/post-sale-safety-v66-20260826.json" ]] ||
    die "manifesto V66 ausente"
  [[ -f "$candidate_dir/docs/freeze/runtime-guard-chain-v67-20260826.json" ]] ||
    die "manifesto da cadeia canônica V67 ausente"
  [[ -f "$candidate_dir/src/services/runtimeGuardChainFreezeRuntimeGuardV67.js" ]] ||
    die "runtime guard canônico V67 ausente"
  [[ -f "$candidate_dir/scripts/assert-post-sale-data-compatibility-v66.mjs" ]] ||
    die "preflight V66 ausente"
  [[ -f "$candidate_dir/scripts/guard-post-sale-safety-v66.mjs" ]] ||
    die "guard V66 ausente"

  [[ -f "$publication_metadata" && ! -L "$publication_metadata" ]] && publication_metadata_exists=1
  [[ -f "$publication_complete" && ! -L "$publication_complete" ]] && publication_complete_exists=1
  [[ "$publication_metadata_exists" == "$publication_complete_exists" ]] ||
    die "envelope de publicação parcial"

  functional_payload_sha="$(functional_payload_sha256 "$candidate_dir")" ||
    die "não foi possível calcular fingerprint funcional"
  safe_overlay_sha="$($sha256_cmd "$candidate_dir/$safe_overlay_name" | awk '{print $1}')"
  base_env_sha="$($sha256_cmd "$candidate_dir/.env" | awk '{print $1}')"
  node_modules_sha="$(directory_payload_sha256 "$candidate_dir/node_modules")" ||
    die "não foi possível calcular fingerprint de node_modules"
  if [[ "$strict_root_owner" == "1" ]]; then
    [[ "$node_modules_sha" =~ ^[0-9a-f]{64}$ ]] || die "node_modules ausente na release real"
  fi

  if [[ "$strict_root_owner" == "1" ]]; then
    [[ "$(stat -c '%u:%g:%a' "$candidate_dir" 2>/dev/null || true)" == "$expected_uid:$expected_gid:700" ]] ||
      die "owner/mode da release candidata inválido"
    [[ "$(stat -c '%u:%g:%a' "$candidate_dir/.env" 2>/dev/null || true)" == "$expected_uid:$expected_gid:600" ]] ||
      die "owner/mode de arquivo protegido inválido: .env"
    for immutable_file in \
      "$candidate_dir/.release-source.json" \
      "$candidate_dir/.staging-complete.json" \
      "$candidate_dir/$safe_overlay_name"; do
      [[ "$(stat -c '%u:%g:%a' "$immutable_file" 2>/dev/null || true)" == "$expected_uid:$expected_gid:400" ]] ||
        die "owner/mode de envelope imutável inválido: ${immutable_file##*/}"
    done
    if [[ "$publication_metadata_exists" == "1" ]]; then
      for immutable_file in "$publication_metadata" "$publication_complete"; do
        [[ "$(stat -c '%u:%g:%a' "$immutable_file" 2>/dev/null || true)" == "$expected_uid:$expected_gid:400" ]] ||
          die "owner/mode de publicação imutável inválido: ${immutable_file##*/}"
      done
    fi
  fi

  payload="$(
    "$node_cmd" - \
      "$candidate_dir/.release-source.json" \
      "$candidate_dir/.staging-complete.json" \
      "$candidate_dir/$safe_overlay_name" \
      "$publication_metadata" \
      "$publication_complete" \
      "$candidate_name" \
      "$v66_runtime_version" \
      "$v70_guard_chain_version" \
      "$v70_data_compatibility_version" \
      "$functional_payload_sha" "$base_env_sha" "$node_modules_sha" <<'NODE'
const crypto = require('node:crypto');
const fs = require('node:fs');
const [
  sourcePath, stagingPath, overlayPath, publicationPath, publicationCompletePath,
  expectedRelease, expectedRuntimeRaw, expectedGuardRaw, expectedDataRaw,
  actualFunctionalPayloadSha, actualBaseEnvSha, actualNodeModulesSha
] = process.argv.slice(2);
const sourceBuffer = fs.readFileSync(sourcePath);
const stagingBuffer = fs.readFileSync(stagingPath);
const overlayBuffer = fs.readFileSync(overlayPath);
const source = JSON.parse(sourceBuffer.toString('utf8'));
const staging = JSON.parse(stagingBuffer.toString('utf8'));
const expectedRuntime = Number(expectedRuntimeRaw);
const expectedGuard = Number(expectedGuardRaw);
const expectedData = Number(expectedDataRaw);
const compatibility = source.postSaleCompatibility;
const commit = String(source.functionalCommit || source.commit || '').toLowerCase();
const tree = String(source.functionalTree || '').toLowerCase();
const sha256 = (value) => crypto.createHash('sha256').update(value).digest('hex');
const sourceSha = sha256(sourceBuffer);
const stagingSha = sha256(stagingBuffer);
const overlaySha = sha256(overlayBuffer);
const publicationExists = fs.existsSync(publicationPath);
const publicationCompleteExists = fs.existsSync(publicationCompletePath);
const assertExactKeys = (value, keys, label) => {
  const actual = Object.keys(value || {}).sort();
  const expected = [...keys].sort();
  if (JSON.stringify(actual) !== JSON.stringify(expected)) throw new Error(`campos de ${label} inválidos`);
};
const assertCanonicalJson = (buffer, value, label) => {
  const canonical = Buffer.from(`${JSON.stringify(value, null, 2)}\n`, 'utf8');
  if (!buffer.equals(canonical)) throw new Error(`${label} não está em serialização canônica imutável`);
};
const validPublicationStatuses = new Set(['staged_candidate', 'production_published']);

assertCanonicalJson(sourceBuffer, source, 'release-source');
assertCanonicalJson(stagingBuffer, staging, 'staging-complete');

if (!Object.hasOwn(source, 'publicationStatus')) throw new Error('publicationStatus ausente');
if (!validPublicationStatuses.has(source.publicationStatus)) throw new Error('publicationStatus desconhecido');
if (source.publicationStatus !== 'staged_candidate') throw new Error('release-source deve permanecer staged_candidate');
assertExactKeys(source, [
  'repository', 'publicationStatus', 'releaseChannel', 'sourceRef',
  'sourceRefResolvedCommit', 'commit', 'functionalCommit', 'functionalTree',
  'guardChainVersion', 'dataCompatibilityVersion', 'productionBranchCommitBefore',
  'productionBranchChanged', 'productionTagRequiredForStaging',
  'productionTagObservation', 'createdAt', 'releaseName', 'postSaleCompatibility'
], 'release-source');

if (source.repository !== 'GitViltaliesmen/vitalismen-maxlien-painel') throw new Error('repository inválido');
if (source.releaseName !== expectedRelease) throw new Error('release divergente');
if (!/^[0-9a-f]{40}$/.test(commit)) throw new Error('commit inválido');
if (!/^[0-9a-f]{40}$/.test(tree)) throw new Error('functionalTree inválida');
if (source.releaseChannel !== 'production') throw new Error('releaseChannel inválido');
if (!/^refs\/heads\/codex\/[A-Za-z0-9][A-Za-z0-9._/-]{0,198}[A-Za-z0-9]$/.test(String(source.sourceRef || ''))) throw new Error('sourceRef inválida');
if (String(source.sourceRefResolvedCommit || '').toLowerCase() !== commit) throw new Error('commit resolvido divergente');
if (String(source.functionalCommit || '').toLowerCase() !== commit) throw new Error('functionalCommit divergente');
if (Number(source.guardChainVersion) !== expectedGuard) throw new Error('guardChainVersion divergente');
if (Number(source.dataCompatibilityVersion) !== expectedData) throw new Error('dataCompatibilityVersion divergente');
if (!/^[0-9a-f]{40}$/.test(String(source.productionBranchCommitBefore || '').toLowerCase())) throw new Error('baseline production inválido');
if (source.productionBranchChanged !== false) throw new Error('garantia de production ausente');
if (source.productionTagRequiredForStaging !== false) throw new Error('staging exige tag indevidamente');
if (!/^(?:ABSENT|[0-9a-f]{40})$/.test(String(source.productionTagObservation || ''))) throw new Error('observação de tag inválida');
if (source.productionTagObservation !== 'ABSENT' && String(source.productionTagObservation).toLowerCase() !== commit) throw new Error('tag opcional contraditória');
if (Object.hasOwn(source, 'branch') || Object.hasOwn(source, 'tag') || Object.hasOwn(source, 'publicationTag')) throw new Error('release-source não pode declarar origem/tag de produção');
if (!compatibility || typeof compatibility !== 'object') throw new Error('metadata de compatibilidade ausente');
if (Number(compatibility.runtimeVersion) !== expectedRuntime) throw new Error('runtimeVersion divergente');
if (Number(compatibility.readsDataCompatibilityThrough) !== expectedRuntime) throw new Error('readsDataCompatibilityThrough divergente');
if (Number(compatibility.writesDataCompatibilityVersion) !== expectedRuntime) throw new Error('writesDataCompatibilityVersion divergente');
if (compatibility.requiresRollbackTargetPreflight !== true) throw new Error('preflight de rollback não obrigatório');

assertExactKeys(staging, [
  'status', 'publicationStatus', 'releaseName', 'sourceRef',
  'sourceRefResolvedCommit', 'commit', 'functionalCommit', 'functionalTree',
  'functionalPayloadSha256', 'releaseMetadataSha256', 'safeOverlaySha256',
  'baseEnvSha256', 'nodeModulesSha256',
  'guardChainVersion', 'dataCompatibilityVersion', 'productionBranchCommitBefore',
  'productionBranchCommitAfter', 'productionBranchChanged',
  'productionTagRequiredForStaging', 'completedAt', 'currentUnchanged',
  'pm2Unchanged', 'postSaleCompatibilityPreflight', 'v66SafeObservationRequired',
  'stdoutSensitiveData'
], 'staging-complete');
if (staging.status !== 'complete') throw new Error('staging incompleto');
if (staging.publicationStatus !== 'staged_candidate') throw new Error('estado do staging divergente');
if (staging.releaseName !== expectedRelease) throw new Error('release do staging divergente');
if (String(staging.commit || '').toLowerCase() !== commit) throw new Error('commit do staging divergente');
if (String(staging.functionalCommit || '').toLowerCase() !== commit) throw new Error('functionalCommit do staging divergente');
if (String(staging.functionalTree || '').toLowerCase() !== tree) throw new Error('tree do staging divergente');
if (staging.sourceRef !== source.sourceRef) throw new Error('sourceRef do staging divergente');
if (String(staging.sourceRefResolvedCommit || '').toLowerCase() !== commit) throw new Error('commit resolvido do staging divergente');
if (staging.releaseMetadataSha256 !== sourceSha) throw new Error('attestation da release metadata divergente');
if (staging.safeOverlaySha256 !== overlaySha) throw new Error('attestation do overlay divergente');
if (staging.functionalPayloadSha256 !== actualFunctionalPayloadSha) throw new Error('fingerprint funcional divergente');
if (staging.baseEnvSha256 !== actualBaseEnvSha) throw new Error('fingerprint de .env divergente');
if (staging.nodeModulesSha256 !== actualNodeModulesSha) throw new Error('fingerprint de node_modules divergente');
if (Number(staging.guardChainVersion) !== expectedGuard || Number(staging.dataCompatibilityVersion) !== expectedData) throw new Error('versão do staging divergente');
if (String(staging.productionBranchCommitBefore || '').toLowerCase() !== String(source.productionBranchCommitBefore).toLowerCase()) throw new Error('baseline production do staging divergente');
if (staging.productionBranchCommitAfter !== staging.productionBranchCommitBefore) throw new Error('production mudou durante staging');
if (staging.productionBranchChanged !== false || staging.productionTagRequiredForStaging !== false) throw new Error('garantias de publicação do staging ausentes');
if (Object.hasOwn(staging, 'tag') || Object.hasOwn(staging, 'publicationTag')) throw new Error('staging não pode declarar tag de publicação');
if (staging.currentUnchanged !== true || staging.pm2Unchanged !== true) throw new Error('garantias do staging ausentes');
if (staging.postSaleCompatibilityPreflight !== 'PASS_SAFE_BOOT') throw new Error('preflight de compatibilidade do staging ausente');
if (staging.v66SafeObservationRequired !== true) throw new Error('perfil safe não obrigatório no staging');

if (publicationExists !== publicationCompleteExists) throw new Error('envelope de publicação parcial');
let effectiveStatus = 'staged_candidate';
let publicationTag = 'STAGED_CANDIDATE_NO_PRODUCTION_TAG';
let publicationSha = 'NOT_PUBLISHED';
let publicationCompleteSha = 'NOT_PUBLISHED';
if (publicationExists) {
  const publicationBuffer = fs.readFileSync(publicationPath);
  const publicationCompleteBuffer = fs.readFileSync(publicationCompletePath);
  const publication = JSON.parse(publicationBuffer.toString('utf8'));
  const publicationComplete = JSON.parse(publicationCompleteBuffer.toString('utf8'));
  assertCanonicalJson(publicationBuffer, publication, 'release-publication');
  assertCanonicalJson(publicationCompleteBuffer, publicationComplete, 'publication-complete');
  publicationSha = sha256(publicationBuffer);
  publicationCompleteSha = sha256(publicationCompleteBuffer);
  assertExactKeys(publication, [
    'version', 'status', 'releaseChannel', 'release', 'functionalCommit',
    'functionalTree', 'functionalPayloadSha256', 'sourceRef', 'publicationTag',
    'publicationTagResolvedCommit', 'releaseMetadataSha256',
    'stagingCompleteSha256', 'safeOverlaySha256', 'guardChainVersion',
    'baseEnvSha256', 'nodeModulesSha256',
    'dataCompatibilityVersion', 'productionBranchCommitBefore',
    'productionBranchCommitAfter', 'productionBranchChanged', 'publishedAt'
  ], 'release-publication');
  if (publication.version !== 1 || publication.status !== 'production_published') throw new Error('publicationStatus publicado inválido');
  if (!validPublicationStatuses.has(publication.status)) throw new Error('publicationStatus desconhecido');
  if (publication.releaseChannel !== 'production' || publication.release !== expectedRelease) throw new Error('identidade da publicação inválida');
  if (String(publication.functionalCommit || '').toLowerCase() !== commit || String(publication.functionalTree || '').toLowerCase() !== tree) throw new Error('identidade funcional da publicação divergente');
  if (publication.functionalPayloadSha256 !== actualFunctionalPayloadSha) throw new Error('fingerprint funcional da publicação divergente');
  if (publication.baseEnvSha256 !== actualBaseEnvSha || publication.nodeModulesSha256 !== actualNodeModulesSha) throw new Error('fingerprint operacional da publicação divergente');
  if (publication.sourceRef !== source.sourceRef) throw new Error('sourceRef da publicação divergente');
  publicationTag = String(publication.publicationTag || '');
  if (!/^production-[0-9]{8}-[0-9a-f]{7}$/.test(publicationTag)) throw new Error('tag publicada inválida');
  if (commit.slice(0, 7) !== publicationTag.slice(-7)) throw new Error('tag publicada não corresponde ao commit');
  if (String(publication.publicationTagResolvedCommit || '').toLowerCase() !== commit) throw new Error('target registrado da tag divergente');
  if (publication.releaseMetadataSha256 !== sourceSha || publication.stagingCompleteSha256 !== stagingSha || publication.safeOverlaySha256 !== overlaySha) throw new Error('hashes da publicação divergentes');
  if (Number(publication.guardChainVersion) !== expectedGuard || Number(publication.dataCompatibilityVersion) !== expectedData) throw new Error('versão da publicação divergente');
  if (publication.productionBranchCommitBefore !== source.productionBranchCommitBefore || publication.productionBranchCommitAfter !== publication.productionBranchCommitBefore || publication.productionBranchChanged !== false) throw new Error('production mudou durante publicação');

  assertExactKeys(publicationComplete, [
    'version', 'status', 'publicationStatus', 'release', 'functionalCommit',
    'functionalTree', 'functionalPayloadSha256', 'sourceRef', 'publicationTag',
    'publicationTagResolvedCommit', 'releaseMetadataSha256',
    'stagingCompleteSha256', 'publicationMetadataSha256', 'safeOverlaySha256',
    'baseEnvSha256', 'nodeModulesSha256',
    'guardChainVersion', 'dataCompatibilityVersion',
    'productionBranchCommitBefore', 'productionBranchCommitAfter',
    'productionBranchChanged', 'pm2Actions', 'outboundActions', 'dropiActions',
    'bridgeExecuted', 'mutationsEnabled', 'completedAt'
  ], 'publication-complete');
  if (publicationComplete.version !== 1 || publicationComplete.status !== 'complete' || publicationComplete.publicationStatus !== 'production_published') throw new Error('attestation publicada inválida');
  if (publicationComplete.release !== expectedRelease || String(publicationComplete.functionalCommit || '').toLowerCase() !== commit || String(publicationComplete.functionalTree || '').toLowerCase() !== tree) throw new Error('identidade da attestation publicada divergente');
  if (publicationComplete.functionalPayloadSha256 !== actualFunctionalPayloadSha || publicationComplete.sourceRef !== source.sourceRef) throw new Error('payload/sourceRef da attestation divergente');
  if (publicationComplete.baseEnvSha256 !== actualBaseEnvSha || publicationComplete.nodeModulesSha256 !== actualNodeModulesSha) throw new Error('fingerprint operacional da attestation divergente');
  if (publicationComplete.publicationTag !== publicationTag || String(publicationComplete.publicationTagResolvedCommit || '').toLowerCase() !== commit) throw new Error('tag da attestation divergente');
  if (publicationComplete.releaseMetadataSha256 !== sourceSha || publicationComplete.stagingCompleteSha256 !== stagingSha || publicationComplete.publicationMetadataSha256 !== publicationSha || publicationComplete.safeOverlaySha256 !== overlaySha) throw new Error('cadeia de hashes publicada divergente');
  if (Number(publicationComplete.guardChainVersion) !== expectedGuard || Number(publicationComplete.dataCompatibilityVersion) !== expectedData) throw new Error('versão da attestation divergente');
  if (publicationComplete.productionBranchCommitBefore !== publication.productionBranchCommitBefore || publicationComplete.productionBranchCommitAfter !== publication.productionBranchCommitBefore || publicationComplete.productionBranchChanged !== false) throw new Error('production da attestation divergente');
  if (publicationComplete.pm2Actions !== 0 || publicationComplete.outboundActions !== 0 || publicationComplete.dropiActions !== 0 || publicationComplete.bridgeExecuted !== false || publicationComplete.mutationsEnabled !== false) throw new Error('publicação registrou efeito operacional proibido');
  effectiveStatus = 'production_published';
}

process.stdout.write([
  commit, tree, source.sourceRef, effectiveStatus, publicationTag, sourceSha,
  stagingSha, publicationSha, publicationCompleteSha, overlaySha,
  actualFunctionalPayloadSha, String(source.productionBranchCommitBefore).toLowerCase()
].join('\t'));
NODE
  )" || die "contrato de release V70 inválido"

  IFS=$'\t' read -r \
    candidate_commit candidate_tree candidate_source_ref candidate_publication_status \
    candidate_tag release_metadata_sha staging_complete_sha publication_metadata_sha \
    publication_complete_sha safe_overlay_sha functional_payload_sha \
    candidate_production_branch_before <<<"$payload"

  if [[ "$candidate_publication_status" == "production_published" ]]; then
    remote_tag_commit="$(remote_required_production_tag_commit "$candidate_tag")"
    [[ "$remote_tag_commit" == "$candidate_commit" ]] ||
      die "tag remota não aponta para o functionalCommit"
    candidate_remote_tag_verified="YES"
  else
    candidate_remote_tag_verified="NOT_PUBLISHED"
  fi

  if [[ -n "$guard_runner" ]]; then
    "$guard_runner" "$candidate_dir" || die "manifesto/guard V66 falhou"
  else
    [[ -f "$candidate_dir/docs/freeze/deploy-publication-attestation-safety-v70-20260827.json" ]] ||
      die "manifesto da cadeia canônica V70 ausente"
    [[ -f "$candidate_dir/src/services/deployPublicationAttestationSafetyFreezeRuntimeGuardV70.js" ]] ||
      die "runtime guard canônico V70 ausente"
    "$env_cmd" -C "$candidate_dir" "$node_cmd" src/services/deployPublicationAttestationSafetyFreezeRuntimeGuardV70.js >/dev/null
    "$env_cmd" -C "$candidate_dir" "$node_cmd" scripts/guard-post-sale-safety-v66.mjs >/dev/null
  fi
}

