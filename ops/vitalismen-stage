  publicationTag, releaseMetadataSha256, stagingCompleteSha256,
  publicationMetadataSha256, publicationCompleteSha256,
  functionalPayloadSha256, nodeModulesSha256, currentExpected, sourceProcessState,
  safeOverlaySha256, baseEnvSha256, guardChainRaw, dataCompatibilityRaw
] = process.argv.slice(2);
const marker = {
  version: 1,
  status: 'PASS_SAFE_BOOT',
  createdAt: new Date().toISOString(),
  release,
  publicationStatus,
  publicationTag,
  remoteTagVerified: publicationStatus === 'production_published',
  functionalCommit,
  functionalTree,
  functionalPayloadSha256,
  nodeModulesSha256,
  sourceRef,
  releaseMetadataSha256,
  stagingCompleteSha256,
  publicationMetadataSha256,
  publicationCompleteSha256,
  guardChainVersion: Number(guardChainRaw),
  dataCompatibilityVersion: Number(dataCompatibilityRaw),
  currentExpected,
  sourceProcessState,
  compatibility: 'PASS_SAFE_BOOT',
  safeProfile: 'V66_SAFE_OBSERVATION_ONLY',
  safeOverlaySha256,
  baseEnvSha256,
  mutationsEnabled: false,
  dropiEffectiveMode: 'REPORT_ONLY',
  bridgeEnabled: false,
  oldRuntimeStartPolicy: 'NEVER_IMPLICIT'
};
fs.writeFileSync(file, `${JSON.stringify(marker, null, 2)}\n`, {encoding: 'utf8', mode: 0o600, flag: 'wx'});
NODE
  secure_mode 0600 "$marker_tmp"
  "$mv_cmd" -Tf "$marker_tmp" "$marker"
}

validate_preflight_marker() {
  local candidate_name="$1"
  local marker
  local current_now
  local env_sha
  marker="$(preflight_marker_path "$candidate_name")"
  current_now="$(current_target)"
  env_sha="$($sha256_cmd "$candidate_dir/.env" | awk '{print $1}')"
  [[ -f "$marker" && ! -L "$marker" ]] || die "preflight V66 ausente"
  if [[ "$strict_root_owner" == "1" ]]; then
    [[ "$(stat -c '%u:%g:%a' "$marker" 2>/dev/null || true)" == "$expected_uid:$expected_gid:600" ]] ||
      die "owner/mode do marker de preflight inválido"
  fi
  "$node_cmd" - \
    "$marker" "$candidate_name" "$candidate_commit" "$candidate_tree" \
    "$candidate_source_ref" "$candidate_publication_status" "$candidate_tag" \
    "$release_metadata_sha" "$staging_complete_sha" "$publication_metadata_sha" \
    "$publication_complete_sha" "$functional_payload_sha" "$node_modules_sha" \
    "$current_now" "$source_process_state" "$safe_overlay_sha" "$env_sha" \
    "$v70_guard_chain_version" "$v70_data_compatibility_version" <<'NODE'
const fs = require('node:fs');
const [
  file, release, functionalCommit, functionalTree, sourceRef, publicationStatus,
  publicationTag, releaseMetadataSha256, stagingCompleteSha256,
  publicationMetadataSha256, publicationCompleteSha256,
  functionalPayloadSha256, nodeModulesSha256, currentExpected, sourceProcessState,
  safeOverlaySha256, baseEnvSha256, guardChainRaw, dataCompatibilityRaw
] = process.argv.slice(2);
const marker = JSON.parse(fs.readFileSync(file, 'utf8'));
const createdAt = Date.parse(marker.createdAt);
const expectedKeys = [
  'baseEnvSha256', 'bridgeEnabled', 'compatibility', 'createdAt', 'currentExpected',
  'dataCompatibilityVersion', 'dropiEffectiveMode', 'functionalCommit',
  'functionalPayloadSha256', 'functionalTree', 'guardChainVersion',
  'mutationsEnabled', 'nodeModulesSha256', 'oldRuntimeStartPolicy', 'publicationCompleteSha256',
  'publicationMetadataSha256', 'publicationStatus', 'publicationTag',
  'release', 'releaseMetadataSha256', 'remoteTagVerified', 'safeOverlaySha256',
  'safeProfile', 'sourceProcessState', 'sourceRef', 'stagingCompleteSha256',
  'status', 'version'
].sort();
if (JSON.stringify(Object.keys(marker).sort()) !== JSON.stringify(expectedKeys)) throw new Error('campos do marker inválidos');
if (marker.version !== 1 || marker.status !== 'PASS_SAFE_BOOT') throw new Error('marker inválido');
if (!Number.isFinite(createdAt) || Date.now() - createdAt > 30 * 60 * 1000 || createdAt > Date.now() + 60_000) throw new Error('marker expirado');
if (marker.release !== release || marker.functionalCommit !== functionalCommit || marker.functionalTree !== functionalTree) throw new Error('candidata divergiu');
if (marker.functionalPayloadSha256 !== functionalPayloadSha256 || marker.sourceRef !== sourceRef) throw new Error('identidade funcional divergiu');
if (marker.nodeModulesSha256 !== nodeModulesSha256) throw new Error('node_modules divergiu');
if (marker.publicationStatus !== publicationStatus || marker.publicationTag !== publicationTag) throw new Error('identidade de publicação divergiu');
if (marker.remoteTagVerified !== (publicationStatus === 'production_published')) throw new Error('prova de tag remota divergiu');
if (marker.releaseMetadataSha256 !== releaseMetadataSha256 || marker.stagingCompleteSha256 !== stagingCompleteSha256) throw new Error('attestation de staging divergiu');
if (marker.publicationMetadataSha256 !== publicationMetadataSha256 || marker.publicationCompleteSha256 !== publicationCompleteSha256) throw new Error('attestation de publicação divergiu');
if (marker.guardChainVersion !== Number(guardChainRaw) || marker.dataCompatibilityVersion !== Number(dataCompatibilityRaw)) throw new Error('versão do preflight divergente');
if (marker.currentExpected !== currentExpected) throw new Error('current mudou após preflight');
if (marker.sourceProcessState !== sourceProcessState) throw new Error('estado PM2 mudou após preflight');
if (marker.safeProfile !== 'V66_SAFE_OBSERVATION_ONLY') throw new Error('perfil safe divergente');
if (marker.safeOverlaySha256 !== safeOverlaySha256) throw new Error('overlay divergente');
if (marker.baseEnvSha256 !== baseEnvSha256) throw new Error('.env base divergiu');
if (marker.mutationsEnabled !== false || marker.dropiEffectiveMode !== 'REPORT_ONLY' || marker.bridgeEnabled !== false) throw new Error('perfil mutável');
if (marker.oldRuntimeStartPolicy !== 'NEVER_IMPLICIT') throw new Error('política de rollback divergente');
NODE
}

switch_current_v66() {
  local target="$1"
  local next_link="$base_dir/.current.v66.next.$$"

  [[ "$target" == "$releases_dir/"* ]] || die "destino de current fora de releases"
  [[ -d "$target" && ! -L "$target" ]] || die "destino de current inválido"
  [[ ! -e "$next_link" && ! -L "$next_link" ]] || die "link temporário já existe"

  "$ln_cmd" -s "$target" "$next_link"
  if ! "$mv_cmd" -Tf "$next_link" "$base_dir/current"; then
    "$unlink_cmd" "$next_link" 2>/dev/null || true
    return 1
  fi
}

wait_candidate_health_v66() {
  local candidate_dir="$1"
  local activation_id="$2"
  local attempts=30
  if [[ "$stage_test_mode" == "true" ]]; then
    attempts="${VITALISMEN_STAGE_HEALTH_ATTEMPTS:-1}"
  fi
  [[ "$attempts" =~ ^[1-9][0-9]*$ && "$attempts" -le 60 ]] ||
    die "quantidade de tentativas de health inválida"
  local health_file="$protected_log_dir/${activation_id}.candidate.health.json"
  local attempt
  local pid
  local proc_cwd

  : >"$health_file"
  secure_mode 0600 "$health_file"

  for attempt in $(seq 1 "$attempts"); do
    pid="$($pm2_cmd pid "$process_name" 2>/dev/null | tail -n 1 || true)"
    if [[ "$pid" =~ ^[1-9][0-9]*$ ]] &&
      "$curl_cmd" -fsS --max-time 8 "$local_health_url" >"$health_file" 2>/dev/null &&
      "$node_cmd" - "$health_file" <<'NODE'
const fs = require('node:fs');
const data = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const safety = data.automationSafety || {};
if (data.status !== 'online') throw new Error('health não online');
if (!Array.isArray(data.degradedReasons) || data.degradedReasons.length !== 0) throw new Error('health degradado');
if (safety.mode !== 'SAFE_OBSERVATION_ONLY') throw new Error('modo não seguro');
if (safety.policy !== 'STRICT_READ_ONLY') throw new Error('política não estrita');
if (safety.strictReadOnly !== true) throw new Error('strict read-only inativo');
if (!Array.isArray(safety.allowedWriteClasses) || safety.allowedWriteClasses.length !== 0) throw new Error('classe de write permitida');
if (safety.zapiReadOnlyStatusAllowed !== true) throw new Error('status Z-API read-only indisponível');
if (safety.zapiInboundPersistenceAllowed !== false) throw new Error('persistência inbound Z-API habilitada');
if (safety.zapiAckPersistenceAllowed !== false) throw new Error('persistência ACK Z-API habilitada');
if (safety.baileysEnabled !== false) throw new Error('Baileys habilitado');
if (safety.mutatingRoutesEnabled !== false) throw new Error('rotas mutantes habilitadas');
if (safety.mutatingSchedulers !== 0) throw new Error('scheduler mutante habilitado');
if (safety.operationalMutationsEnabled !== false) throw new Error('mutações habilitadas');
if (safety.compatibilityBridgeComplete !== false) throw new Error('bridge habilitado');
if (safety.dropiSyncMode !== 'REPORT_ONLY') throw new Error('Dropi não está em REPORT_ONLY');
if (safety.dropiApplyAllowed !== false) throw new Error('Dropi APPLY permitido');
NODE
    then
      proc_cwd="$($readlink_cmd -f "/proc/$pid/cwd" 2>/dev/null || true)"
      if [[ "$proc_cwd" == "$candidate_dir" ]] &&
        "$curl_cmd" -fsS --max-time 12 "$official_health_url" >/dev/null 2>&1 &&
        "$curl_cmd" -fsS --max-time 12 "$official_panel_url" >/dev/null 2>&1; then
        candidate_pid="$pid"
        return 0
      fi
    fi
    "$sleep_cmd" 2
  done
  return 1
}

source_health_if_required() {
  if [[ "$source_process_state" == "STOPPED_CONTAINMENT" ]]; then
    echo "SOURCE_HEALTH=SKIPPED_EXPECTED_CONTAINMENT"
    return 0
  fi
  "$curl_cmd" -fsS --max-time 8 "$local_health_url" >/dev/null
  echo "SOURCE_HEALTH=OK"
}

load_v66_activation_permit() {
  local payload

  [[ -f "$permit_file" && ! -L "$permit_file" ]] ||
    die "autorização root ausente, inválida ou expirada"
  if [[ "$strict_root_owner" == "1" ]]; then
    [[ "$(stat -c '%u:%g:%a' "$permit_file" 2>/dev/null || true)" == "$expected_uid:$expected_gid:600" ]] ||
      die "owner/mode do permit inválido"
  fi

  payload="$(
    "$node_cmd" - "$permit_file" "$candidate_name" "$candidate_commit" \
      "$candidate_tag" "${source_current##*/}" <<'NODE'
const fs = require('node:fs');
const [file, expectedRelease, expectedCommit, expectedTag, expectedCurrent] = process.argv.slice(2);
const permit = JSON.parse(fs.readFileSync(file, 'utf8'));
const expectedKeys = [
  'commit', 'createdAt', 'currentExpected', 'expiresAt', 'release',
  'rollback', 'singleUse', 'status', 'tag', 'version'
];
if (JSON.stringify(Object.keys(permit).sort()) !== JSON.stringify(expectedKeys)) {
  throw new Error('campos do permit inválidos');
}
if (permit.version !== 1 || permit.status !== 'authorized' || permit.singleUse !== true) {
  throw new Error('contrato do permit inválido');
}
if (permit.release !== expectedRelease || permit.commit !== expectedCommit || permit.tag !== expectedTag) {
  throw new Error('permit não corresponde à candidata');
}
if (permit.currentExpected !== expectedCurrent || permit.rollback !== expectedCurrent) {
  throw new Error('baseline esperado divergente');
}
if (!/^[0-9a-f]{40}$/.test(String(permit.commit || ''))) throw new Error('commit inválido');
if (!/^production-[0-9]{8}-[0-9a-f]{7}$/.test(String(permit.tag || ''))) throw new Error('tag inválida');
if (!/^[0-9]{8}T[0-9]{6}Z_production-[0-9]{8}-[0-9a-f]{7}$/.test(String(permit.release || ''))) throw new Error('release inválida');
if (permit.commit.slice(0, 7) !== permit.tag.slice(-7)) throw new Error('tag/commit divergentes');
const createdAt = Date.parse(permit.createdAt);
const expiresAt = Date.parse(permit.expiresAt);
const now = Date.now();
if (!Number.isFinite(createdAt) || !Number.isFinite(expiresAt)) throw new Error('datas inválidas');
if (createdAt > now + 60_000 || expiresAt <= now || expiresAt <= createdAt || expiresAt - createdAt > 3_600_000) {
  throw new Error('janela do permit inválida');
}
process.stdout.write('VALID');
NODE
  )" || die "autorização root ausente, inválida ou expirada"
  [[ "$payload" == "VALID" ]] || die "autorização root ausente, inválida ou expirada"
}

consume_v66_activation_permit() {
  local consumed="$state_dir/.activate-permit.consumed.$$"
  [[ ! -e "$consumed" && ! -L "$consumed" ]] || die "marcador de consumo já existe"
  "$mv_cmd" -T "$permit_file" "$consumed"
  [[ ! -e "$permit_file" && ! -L "$permit_file" ]] || die "permit não foi consumido"
  rm -f -- "$consumed"
}

validate_activation_prerequisites_v70() {
  validate_v70_release "$candidate_dir" "$candidate_name"
  [[ "$candidate_publication_status" == "production_published" ]] ||
    die "ativação exige publicationStatus production_published"
  [[ "$candidate_remote_tag_verified" == "YES" ]] ||
    die "ativação exige tag remota validada no functionalCommit"
  validate_safe_overlay "$candidate_dir"
  validate_preflight_marker "$candidate_name"
  load_v66_activation_permit
  source_health_if_required
  run_compatibility_preflight "$candidate_dir" "$candidate_dir/.release-source.json" >/dev/null ||
    die "compatibility preflight falhou antes da ativação"
}

if [[ "$stage_test_mode" == "true" && "${VITALISMEN_STAGE_TEST_SOURCE_ONLY:-false}" == "true" ]]; then
  [[ "${BASH_SOURCE[0]}" != "$0" ]] || die "modo source-only exige source do helper"
  return 0
fi

action="${1:-}"

if [[ "$action" == "status" ]]; then
  bash -n "$0" || {
    echo "HELPER=SINTAXE_INVALIDA"
    exit 1
  }

  current_target="$(current_target)"
  pm2_pid="$("$pm2_cmd" pid "$process_name" 2>/dev/null | tail -n 1 || true)"

  activation_allowed="NAO"
  operational_mode="V70_PUBLICACAO_PREFLIGHT_E_PERMIT_OBRIGATORIOS"

  echo "HELPER=OK"
  echo "MODO=$operational_mode"
  echo "CURRENT=${current_target:-AUSENTE}"
  echo "PM2_PID=${pm2_pid:-AUSENTE}"
  echo "SAIDA_SENSIVEL=PROTEGIDA"
  echo "STAGING_PERMITIDO=SIM"
  echo "ATIVACAO_PERMITIDA=$activation_allowed"
  exit 0
fi

if [[ "$action" == "activate" ]]; then
  die "activate legado bloqueado: use v66-preflight e v66-activate-safe; fallback automático foi removido"
fi

if [[ "$action" == "v70-publish" ]]; then
  [[ "$#" -eq 6 ]] || die "uso: vitalismen-stage v70-publish RELEASE SOURCE_REF EXPECTED_COMMIT EXPECTED_TREE EXPECTED_TAG"
  candidate_name="$2"
  requested_source_ref="$3"
  requested_commit="$4"
  requested_tree="$5"
  requested_tag="$6"
  candidate_dir="$(release_dir_for_name "$candidate_name")"
  publication_id="$(new_activation_id v70-publish)"
  authorized_publish_ref="${VITALISMEN_PUBLISH_AUTHORIZED_SOURCE_REF:-}"
  authorized_publish_tag="${VITALISMEN_PUBLISH_AUTHORIZED_TAG:-}"

  [[ -n "$authorized_publish_ref" && "$requested_source_ref" == "$authorized_publish_ref" ]] ||
    die "source ref de publicação não corresponde à autorização exata"
  [[ -n "$authorized_publish_tag" && "$requested_tag" == "$authorized_publish_tag" ]] ||
    die "tag de publicação não corresponde à autorização exata"
  [[ "$requested_commit" =~ ^[0-9a-f]{40}$ ]] || die "EXPECTED_COMMIT de publicação inválido"
  [[ "$requested_tree" =~ ^[0-9a-f]{40}$ ]] || die "EXPECTED_TREE de publicação inválido"
  [[ "$requested_tag" =~ ^production-[0-9]{8}-[0-9a-f]{7}$ ]] || die "EXPECTED_TAG de publicação inválida"
  [[ "$requested_tag" == "${candidate_name#*_}" ]] || die "EXPECTED_TAG não corresponde ao nome da release"
  [[ "${requested_commit:0:7}" == "${requested_tag: -7}" ]] || die "EXPECTED_TAG não corresponde ao EXPECTED_COMMIT"

  ensure_private_dirs "$state_dir" "$protected_log_dir"
  exec 9>"$state_dir/vitalismen-stage.lock"
  "$flock_cmd" -n 9 || die "outro preflight/publish/activate V70 está em execução"
  [[ ! -e "$permit_file" && ! -L "$permit_file" ]] ||
    die "permit de ativação não pode existir durante publicação"

  detect_source_process_state
  current_before="$source_current"
  pm2_pid_before="$source_pm2_pid"
  validate_v70_release "$candidate_dir" "$candidate_name"
  [[ "$candidate_publication_status" == "staged_candidate" ]] || die "release já publicada ou estado inválido"
  [[ "$candidate_source_ref" == "$requested_source_ref" ]] || die "SOURCE_REF diverge da identidade staged"
  [[ "$candidate_commit" == "$requested_commit" ]] || die "EXPECTED_COMMIT diverge da identidade staged"
  [[ "$candidate_tree" == "$requested_tree" ]] || die "EXPECTED_TREE diverge da identidade staged"

  production_branch_before_publish="$(remote_production_head)"
  [[ "$production_branch_before_publish" == "$candidate_production_branch_before" ]] ||
    die "origin/production mudou desde o staging"
  publication_tag_commit="$(remote_required_production_tag_commit "$requested_tag")"
  [[ "$publication_tag_commit" == "$requested_commit" ]] ||
    die "tag remota não aponta para o EXPECTED_COMMIT"

  publication_metadata="$candidate_dir/$publication_metadata_name"
  publication_complete="$candidate_dir/$publication_complete_name"
  publication_metadata_tmp="$candidate_dir/.${publication_metadata_name}.tmp.$$"
  publication_complete_tmp="$candidate_dir/.${publication_complete_name}.tmp.$$"
  publication_written=0
  publication_cleanup() {
    rm -f -- "$publication_metadata_tmp" "$publication_complete_tmp"
    if [[ "$publication_written" != "1" ]]; then
      rm -f -- "$publication_metadata" "$publication_complete"
    fi
  }
  trap publication_cleanup EXIT
  [[ ! -e "$publication_metadata" && ! -L "$publication_metadata" ]] || die "release-publication já existe"
  [[ ! -e "$publication_complete" && ! -L "$publication_complete" ]] || die "publication-complete já existe"

  published_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  production_branch_after_publish="$(remote_production_head)"
  [[ "$production_branch_after_publish" == "$production_branch_before_publish" ]] ||
    die "origin/production mudou durante a publicação"
  publication_tag_commit_after="$(remote_required_production_tag_commit "$requested_tag")"
  [[ "$publication_tag_commit_after" == "$requested_commit" ]] ||
    die "tag remota mudou durante a publicação"
  functional_payload_after="$(functional_payload_sha256 "$candidate_dir")"
  [[ "$functional_payload_after" == "$functional_payload_sha" ]] ||
    die "functional tree/payload mudou durante a publicação"
  base_env_after="$($sha256_cmd "$candidate_dir/.env" | awk '{print $1}')"
  [[ "$base_env_after" == "$base_env_sha" ]] || die ".env mudou durante a publicação"
  node_modules_after="$(directory_payload_sha256 "$candidate_dir/node_modules")"
  [[ "$node_modules_after" == "$node_modules_sha" ]] ||
    die "node_modules mudou durante a publicação"

  "$node_cmd" - \
    "$publication_metadata_tmp" "$candidate_name" "$candidate_commit" "$candidate_tree" \
    "$functional_payload_sha" "$candidate_source_ref" "$requested_tag" "$publication_tag_commit" \
    "$release_metadata_sha" "$staging_complete_sha" "$safe_overlay_sha" \
    "$base_env_sha" "$node_modules_sha" \
    "$v70_guard_chain_version" "$v70_data_compatibility_version" \
    "$production_branch_before_publish" "$production_branch_after_publish" "$published_at" <<'NODE'
const fs = require('node:fs');
const [
  file, release, functionalCommit, functionalTree, functionalPayloadSha256,
  sourceRef, publicationTag, publicationTagResolvedCommit,
  releaseMetadataSha256, stagingCompleteSha256, safeOverlaySha256,
  baseEnvSha256, nodeModulesSha256,
  guardChainRaw, dataCompatibilityRaw, productionBranchCommitBefore,
  productionBranchCommitAfter, publishedAt
] = process.argv.slice(2);
const publication = {
  version: 1,
  status: 'production_published',
  releaseChannel: 'production',
  release,
  functionalCommit,
  functionalTree,
  functionalPayloadSha256,
  sourceRef,
  publicationTag,
  publicationTagResolvedCommit,
  releaseMetadataSha256,
  stagingCompleteSha256,
  safeOverlaySha256,
  baseEnvSha256,
  nodeModulesSha256,
  guardChainVersion: Number(guardChainRaw),
  dataCompatibilityVersion: Number(dataCompatibilityRaw),
  productionBranchCommitBefore,
  productionBranchCommitAfter,
  productionBranchChanged: false,
  publishedAt
};
fs.writeFileSync(file, `${JSON.stringify(publication, null, 2)}\n`, {encoding: 'utf8', mode: 0o600, flag: 'wx'});
NODE
  secure_mode 0600 "$publication_metadata_tmp"
  publication_metadata_sha="$($sha256_cmd "$publication_metadata_tmp" | awk '{print $1}')"

  "$node_cmd" - \
    "$publication_complete_tmp" "$candidate_name" "$candidate_commit" "$candidate_tree" \
    "$functional_payload_sha" "$candidate_source_ref" "$requested_tag" "$publication_tag_commit" \
    "$release_metadata_sha" "$staging_complete_sha" "$publication_metadata_sha" \
    "$safe_overlay_sha" "$base_env_sha" "$node_modules_sha" \
    "$v70_guard_chain_version" "$v70_data_compatibility_version" \
    "$production_branch_before_publish" "$production_branch_after_publish" "$published_at" <<'NODE'
const fs = require('node:fs');
const [
  file, release, functionalCommit, functionalTree, functionalPayloadSha256,
  sourceRef, publicationTag, publicationTagResolvedCommit,
  releaseMetadataSha256, stagingCompleteSha256, publicationMetadataSha256,
  safeOverlaySha256, baseEnvSha256, nodeModulesSha256,
  guardChainRaw, dataCompatibilityRaw,
  productionBranchCommitBefore, productionBranchCommitAfter, completedAt
] = process.argv.slice(2);
const attestation = {
  version: 1,
  status: 'complete',
  publicationStatus: 'production_published',
  release,
  functionalCommit,
  functionalTree,
  functionalPayloadSha256,
  sourceRef,
  publicationTag,
  publicationTagResolvedCommit,
  releaseMetadataSha256,
  stagingCompleteSha256,
  publicationMetadataSha256,
  safeOverlaySha256,
  baseEnvSha256,
  nodeModulesSha256,
  guardChainVersion: Number(guardChainRaw),
  dataCompatibilityVersion: Number(dataCompatibilityRaw),
  productionBranchCommitBefore,
  productionBranchCommitAfter,
  productionBranchChanged: false,
  pm2Actions: 0,
  outboundActions: 0,
  dropiActions: 0,
  bridgeExecuted: false,
  mutationsEnabled: false,
  completedAt
};
fs.writeFileSync(file, `${JSON.stringify(attestation, null, 2)}\n`, {encoding: 'utf8', mode: 0o600, flag: 'wx'});
NODE
  secure_mode 0600 "$publication_complete_tmp"

  current_after="$(current_target)"
  pm2_pid_after="$("$pm2_cmd" pid "$process_name" 2>/dev/null | tail -n 1 || true)"
  [[ "$current_after" == "$current_before" ]] || die "current mudou durante a publicação"
  [[ "$pm2_pid_after" == "$pm2_pid_before" ]] || die "PID PM2 mudou durante a publicação"

  "$mv_cmd" -Tf "$publication_metadata_tmp" "$publication_metadata"
  "$mv_cmd" -Tf "$publication_complete_tmp" "$publication_complete"
  secure_mode 0400 "$publication_metadata" "$publication_complete"
  publication_complete_sha="$($sha256_cmd "$publication_complete" | awk '{print $1}')"
  validate_v70_release "$candidate_dir" "$candidate_name"
  [[ "$candidate_publication_status" == "production_published" ]] || die "publicação final não validou"
  [[ "$candidate_tag" == "$requested_tag" ]] || die "tag final publicada divergiu"

  rm -f -- "$(preflight_marker_path "$candidate_name")"
  write_publication_audit_event \
    "publication_succeeded" "$publication_id" "$candidate_name" "$candidate_commit" \
    "$candidate_tree" "$candidate_source_ref" "$candidate_tag" \
    "$production_branch_before_publish" "$production_branch_after_publish"
  publication_written=1
  trap - EXIT

  echo "V70_PUBLICATION=SUCCESS"
  echo "PUBLICATION_ID=$publication_id"
  echo "PUBLICATION_STATUS=$candidate_publication_status"
  echo "PUBLICATION_TAG=$candidate_tag"
  echo "PUBLICATION_TAG_RESOLVED_COMMIT=$publication_tag_commit"
