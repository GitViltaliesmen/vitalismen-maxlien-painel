prepare_safe_overlay() {
  local candidate_dir="$1"
  local overlay="$candidate_dir/$safe_overlay_name"
  local temporary="$candidate_dir/.${safe_overlay_name}.tmp.$$"
  local expected_sha
  local actual_sha

  expected_sha="$(safe_profile_sha256)"
  [[ ! -e "$temporary" && ! -L "$temporary" ]] || die "overlay temporário já existe"
  safe_profile_content >"$temporary"
  secure_mode 0600 "$temporary"
  "$mv_cmd" -Tf "$temporary" "$overlay"
  actual_sha="$($sha256_cmd "$overlay" | awk '{print $1}')"
  [[ "$actual_sha" == "$expected_sha" ]] || die "overlay safe divergente"
  safe_overlay_sha="$actual_sha"
}

validate_safe_overlay() {
  local candidate_dir="$1"
  local overlay="$candidate_dir/$safe_overlay_name"
  local expected_sha
  local actual_sha

  [[ -f "$overlay" && ! -L "$overlay" ]] || die "overlay safe ausente"
  if [[ "$strict_root_owner" == "1" ]]; then
    [[ "$(stat -c '%u:%g:%a' "$overlay" 2>/dev/null || true)" == "$expected_uid:$expected_gid:400" ]] ||
      die "owner/mode do overlay safe inválido"
  fi
  expected_sha="$(safe_profile_sha256)"
  actual_sha="$($sha256_cmd "$overlay" | awk '{print $1}')"
  [[ "$actual_sha" == "$expected_sha" ]] || die "overlay safe foi alterado"
  safe_overlay_sha="$actual_sha"
}

