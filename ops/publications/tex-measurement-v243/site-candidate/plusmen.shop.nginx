map $http_user_agent $plusmen_tex_document {
    default /__plusmen_tex_desktop_no_file__;
    "~*iPhone|iPod|Android.*Mobile|Windows Phone|IEMobile|Opera Mini" /index.html;
}

server {
    listen 80;
    listen [::]:80;
    server_name plusmen.shop www.plusmen.shop;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://plusmen.shop$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name plusmen.shop www.plusmen.shop;
    ssl_certificate /etc/letsencrypt/live/plusmen.shop/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/plusmen.shop/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    # Preserve the site's previous root and EXUTRA behavior.
    location = / { return 302 /exutra$is_args$args; }
    location = /exutra/ { return 302 /exutra$is_args$args; }
    location ~* "(^|/)\.(?!well-known(?:/|$))" { return 404; }
    location ~* "(?:\.bak(?:[-.][^/]*)?|\.backup(?:[-.][^/]*)?|\.old(?:[-.][^/]*)?|\.tmp(?:[-.][^/]*)?|\.log|\.dump|\.sql|\.map|~)$" { return 404; }

    # Isolated /tex smartphone presentation; desktop retains the legacy response.
    location = /tex {
        include /etc/nginx/snippets/plusmen-tex-mobile-v1.conf;
    }
    location = /tex/ {
        include /etc/nginx/snippets/plusmen-tex-mobile-v1.conf;
    }
    location @plusmen_tex_legacy {
        include /etc/nginx/snippets/plusmen-local-proxy.conf;
    }
    # BEGIN TEX ULTRA WEB CHAT V240
    include /etc/nginx/snippets/plusmen-tex-chat-proxy-v240.conf;
    # END TEX ULTRA WEB CHAT V240

    location ^~ /tex-assets/ {
        alias /var/www/plusmen-tex-vsl-v1/assets/;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location ~ ^/(tex|bienestar|vitpower|vitpoers)(/|$) {
        include /etc/nginx/snippets/plusmen-local-proxy.conf;
    }
    location /exutra {
        include /etc/nginx/snippets/plusmen-local-proxy.conf;
    }
    location /assets/ {
        include /etc/nginx/snippets/plusmen-local-proxy.conf;
    }
    location /protocolo1/assets/ {
        include /etc/nginx/snippets/plusmen-local-proxy.conf;
    }
    location = /favicon.svg {
        include /etc/nginx/snippets/plusmen-local-proxy.conf;
    }
    # BEGIN TEX MEASUREMENT V243
    location = /api/public/tex-measurement {
        include /etc/nginx/snippets/plusmen-local-proxy.conf;
    }
    location = /api/private/tex-measurement-proof {
        include /etc/nginx/snippets/plusmen-local-proxy.conf;
    }
    # END TEX MEASUREMENT V243

    location = /api/public/vitpower-meta {
        include /etc/nginx/snippets/plusmen-local-proxy.conf;
    }

    location = /api/whatsapp/vsl-entry {
        proxy_pass https://maxlien.shop;
        proxy_ssl_server_name on;
        proxy_ssl_name maxlien.shop;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_http_version 1.1;
        proxy_set_header Host maxlien.shop;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }
    location /api/public/ {
        proxy_pass https://maxlien.shop;
        proxy_ssl_server_name on;
        proxy_ssl_name maxlien.shop;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host maxlien.shop;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }
    location / { return 404; }
}
